# Environment Configuration for SIH26102 MPLADS Backend
PROJECT_NAME="SIH26102 — MPLADS AI Audit Intelligence System"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (SQLite by default for portable local evaluation, PostgreSQL+PostGIS for production)
DATABASE_URL=sqlite:///./mplads_audit.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mplads_db

# Security & JWT Auth
SECRET_KEY=sih26102_secure_audit_secret_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Anomaly Priority Thresholds (0-100 score)
THRESHOLD_LOW=30
THRESHOLD_MEDIUM=60
THRESHOLD_HIGH=80
THRESHOLD_CRITICAL=100

# File Paths
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
REJECTED_DATA_DIR=./data/rejected
METADATA_DIR=./data/metadata
REPORTS_DIR=./reports

# Model Settings
NLP_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_ANALYSIS_VERSION=v1.0.0
